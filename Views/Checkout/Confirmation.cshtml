@model EasyToShop.DTOs.OrderSummaryDto

@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card border-0 shadow-sm p-5">
                <div class="mb-3 text-success">
                    <i class="bi bi-check-circle-fill display-1"></i>
                </div>
                <h1 class="fw-bold text-success mb-2">Thank You for Your Order!</h1>
                <p class="text-muted fs-5 mb-4">
                    Your order <strong>#@Model.OrderId</strong> has been placed successfully.
                </p>

                <div class="border rounded text-start p-4 bg-light mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Order Summary</h5>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Order ID:</div>
                        <div class="col-sm-8 fw-semibold">#@Model.OrderId</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Customer Name:</div>
                        <div class="col-sm-8">@Model.FullName</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Email Address:</div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Shipping Address:</div>
                        <div class="col-sm-8">@Model.ShippingAddress</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Payment Method:</div>
                        <div class="col-sm-8">@Model.PaymentMethod</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Date & Time:</div>
                        <div class="col-sm-8">@Model.OrderDate.ToString("f")</div>
                    </div>

                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Status:</div>
                        <div class="col-sm-8"><span class="badge bg-success">@Model.Status</span></div>
                    </div>

                    <hr />

                    <div class="row fs-5">
                        <div class="col-sm-4 fw-bold">Total Amount:</div>
                        <div class="col-sm-8 fw-bold text-primary">$@Model.TotalAmount.ToString("F2")</div>
                    </div>
                </div>

                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg me-2">
                        <i class="bi bi-house me-1"></i> Back to Shop
                    </a>
                    <a asp-controller="Home" asp-action="ReturnPolicy" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-info-circle me-1"></i> Return Policy
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>