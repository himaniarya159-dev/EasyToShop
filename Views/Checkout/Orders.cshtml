@model IEnumerable<EasyToShop.Data.Entities.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="container my-4">
    <h2 class="mb-3">Order History</h2>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm p-4 text-center">
            <h4 class="alert-heading">No Orders Found!</h4>
            <p class="mb-0">You haven't placed any orders yet or the database table is currently empty.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Start Shopping</a>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Order #@order.Id</strong> &bull; 
                        <small class="text-light">@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</small>
                    </div>
                    <div>
                        <span class="badge bg-success">@order.Status</span>
                        <strong class="ms-2 text-warning">$@order.TotalAmount.ToString("F2")</strong>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Customer Information</h6>
                            <p class="mb-1"><strong>Name:</strong> @order.FullName</p>
                            <p class="mb-1"><strong>Email:</strong> @order.Email</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Shipping Details</h6>
                            <p class="mb-1"><strong>Address:</strong> @order.ShippingAddress, @order.City (@order.PostalCode)</p>
                            <p class="mb-1"><strong>Payment:</strong> @order.PaymentMethod</p>
                        </div>
                    </div>

                    <h6>Items Ordered</h6>
                    <ul class="list-group">
                        @if (order.OrderItems != null && order.OrderItems.Any())
                        {
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@(item.Product?.Name ?? "Product")</strong>
                                        <small class="text-muted d-block">Qty: @item.Quantity &times; $@item.UnitPrice.ToString("F2")</small>
                                    </div>
                                    <span class="fw-bold">$@(item.UnitPrice * item.Quantity)</span>
                                </li>
                            }
                        }
                    </ul>
                </div>
            </div>
        }
    }
</div>