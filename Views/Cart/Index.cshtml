@model EasyToShop.Models.CartViewModel

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Main Cart Items List -->
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0">Shopping Cart</h3>
                <span class="badge bg-primary rounded-pill px-3 py-2">
                    @Model.Items.Sum(i => i.Quantity) items
                </span>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (!Model.Items.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center">
                    <i class="bi bi-cart-x text-muted display-1 mb-3"></i>
                    <h4>Your cart is empty</h4>
                    <p class="text-secondary">Looks like you haven't added anything to your cart yet.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary col-md-4 mx-auto mt-2">Start Shopping</a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="card border-0 shadow-sm p-3">
                            <div class="row align-items-center g-3">
                                <!-- Product Image Placeholder -->
                                <div class="col-3 col-md-2">
                                    <div class="ratio ratio-1x1 bg-light rounded d-flex align-items-center justify-content-center border">
                                        <i class="bi bi-box-seam fs-3 text-secondary"></i>
                                    </div>
                                </div>

                                <!-- Product Details -->
                                <div class="col-9 col-md-4">
                                    <h6 class="fw-bold mb-1">@item.ProductName</h6>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle mb-1">
                                        In Stock
                                    </span>
                                </div>

                                <!-- Quantity Controls -->
                                <div class="col-6 col-md-3">
                                    <div class="input-group input-group-sm">
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="actionType" value="decrease" />
                                            <button class="btn btn-outline-secondary" type="submit">-</button>
                                        </form>
                                        
                                        <input type="text" class="form-control text-center bg-white" value="@item.Quantity" readonly />
                                        
                                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <input type="hidden" name="actionType" value="increase" />
                                            <button class="btn btn-outline-secondary" type="submit">+</button>
                                        </form>
                                    </div>
                                </div>

                                <!-- Total Price & Remove Button -->
                                <div class="col-6 col-md-3 text-end d-flex align-items-center justify-content-end gap-3">
                                    <span class="fw-bold fs-6">$@item.Total.ToString("F2")</span>
                                    <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit" class="btn btn-link text-danger p-0 border-0">
                                            <i class="bi bi-trash fs-5"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Order Summary Sidebar -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4">
                <h5 class="fw-bold mb-4">Order Summary</h5>
                
                <div class="d-flex justify-content-between mb-2 text-secondary">
                    <span>Subtotal</span>
                    <span>$@Model.Subtotal.ToString("F2")</span>
                </div>

                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Discount (@Model.AppliedCouponCode)</span>
                        <span>-$@Model.DiscountAmount.ToString("F2")</span>
                    </div>
                }

                <div class="d-flex justify-content-between mb-3 text-secondary">
                    <span>Shipping</span>
                    <span>$@((Model.Items.Any() ? Model.ShippingFee : 0m).ToString("F2"))</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-4 fs-5 fw-bold">
                    <span>Total</span>
                    <span>$@Model.GrandTotal.ToString("F2")</span>
                </div>

                <!-- Promo Code Form -->
                <form asp-controller="Cart" asp-action="ApplyCoupon" method="post" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="promoCode" class="form-control" placeholder="Promo code (e.g. SAVE20)" required />
                        <button class="btn btn-outline-secondary" type="submit">Apply</button>
                    </div>
                </form>

                <!-- Checkout Button -->
                <button class="btn btn-primary w-100 py-2 @(!Model.Items.Any() ? "disabled" : "")">
                   Proceed to Checkout
                   <a href="/Checkout" class="btn btn-primary w-100 btn-lg">Proceed to Checkout</a>
                </button>

                <div class="text-center mt-3 text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i> Secure checkout
                </div>
            </div>
        </div>
    </div>
</div>