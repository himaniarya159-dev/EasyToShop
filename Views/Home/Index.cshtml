@model IEnumerable<EasyToShop.Data.Entities.Product>

@{
    ViewData["Title"] = "Storefront";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">Welcome to EasyToShop</h1>
        <p class="text-secondary lead">Discover fashion for Women, Men, and Kids.</p>
    </div>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3">
                <div class="card h-100 border-0 shadow-sm overflow-hidden">
                    <!-- Clickable Image -->
                    <a href="/Home/Details/@product.Id">
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;">
                    </a>
                    
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-secondary-subtle text-dark border">@product.Category</span>
                            <span class="fw-bold text-primary fs-5">$@product.Price.ToString("F2")</span>
                        </div>
                        
                        <!-- Clickable Title -->
                        <h6 class="card-title fw-bold mb-1">
                            <a href="/Home/Details/@product.Id" class="text-decoration-none text-dark">
                                @product.Name
                            </a>
                        </h6>
                        <p class="card-text text-muted small flex-grow-1">@product.Description</p>
                        
                        <!-- ADD TO CART FORM -->
                        <form action="/Cart/AddToCart" method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.Id" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-primary w-100 btn-sm">
                                <i class="bi bi-cart-plus me-1"></i> Add to Cart
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<div class="position-relative">
    <input type="text" id="searchInput" class="form-control" placeholder="Search products..." autocomplete="off" />
    <div id="searchResults" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000;"></div>
</div>

<script>
    document.getElementById('searchInput').addEventListener('input', async function () {
        let term = this.value;
        let resultsContainer = document.getElementById('searchResults');

        if (term.length < 2) {
            resultsContainer.innerHTML = '';
            return;
        }

        let response = await fetch(`/Home/SearchProducts?term=${encodeURIComponent(term)}`);
        let products = await response.json();

        resultsContainer.innerHTML = '';
        products.forEach(p => {
            let item = document.createElement('a');
            item.href = `/Home/Details/${p.id}`;
            item.className = 'list-group-item list-group-item-action';
            item.innerText = `${p.title} - $${p.price}`;
            resultsContainer.appendChild(item);
        });
    });
</script>