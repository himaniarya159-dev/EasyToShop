@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="fw-bold mb-4"><i class="bi bi-shield-lock text-primary me-2"></i> Privacy Policy</h1>
            <p class="text-muted">Effective Date: October 2026</p>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold mb-3">1. Information We Collect</h4>
                <p>When you visit EasyToShop or place an order, we collect specific information to deliver your order seamlessly:</p>
                <ul>
                    <li><strong>Personal Details:</strong> Name, email address, phone number, and shipping address when placing an order or registering an account.</li>
                    <li><strong>Payment Information:</strong> Transaction data necessary to process checkout orders safely.</li>
                    <li><strong>Session & Browser Data:</strong> IP address, device type, and shopping cart items stored via session cookies.</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold mb-3">2. How We Use Your Information</h4>
                <p>We use the collected information strictly to:</p>
                <ul>
                    <li>Process, fulfill, and ship your orders.</li>
                    <li>Send order status updates and confirmation receipts.</li>
                    <li>Maintain active shopping carts and handle returns or customer support inquiries.</li>
                    <li>Improve site navigation, layout, and shopping experience.</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold mb-3">3. Data Sharing & Security</h4>
                <p>Your privacy is important to us. We do not sell or rent your personal data to third parties. We only share essential information with delivery services (e.g., couriers) to fulfill package shipments.</p>
            </div>

            <div class="card border-0 shadow-sm p-4 bg-light">
                <h5 class="fw-bold mb-2">Questions Regarding Privacy?</h5>
                <p class="mb-0 text-muted">If you have any questions or requests regarding your personal data, please reach out through our contact channel.</p>
            </div>
        </div>
    </div>
</div>