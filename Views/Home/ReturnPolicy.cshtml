@{
    ViewData["Title"] = "Return & Refund Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="fw-bold mb-4"><i class="bi bi-arrow-return-left text-primary me-2"></i> Return & Refund Policy</h1>
            <p class="text-muted">Last updated: October 2026</p>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold text-primary mb-3">14-Day Return Guarantee</h4>
                <p>At <strong>EasyToShop</strong>, customer satisfaction is our priority. If you are not completely satisfied with your purchase, you may return the item within <strong>14 days (2 weeks)</strong> from the date of delivery for a full refund or exchange.</p>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold mb-3">Eligibility Requirements</h4>
                <p>To be eligible for a return, your item must meet the following conditions:</p>
                <ul>
                    <li>The request must be submitted within <strong>14 days</strong> of receiving your package.</li>
                    <li>The item must be unused, unworn, and in the same condition as when received.</li>
                    <li>The item must be in its original packaging with all tags attached.</li>
                    <li>Proof of purchase (Order Number and Email) is required.</li>
                </ul>
            </div>

            <div class="card border-0 shadow-sm p-4 mb-4">
                <h4 class="fw-bold mb-3">How to Initiate a Return</h4>
                <ol class="mb-0">
                    <li class="mb-2">Contact our support team with your <strong>Order ID</strong> and reason for return.</li>
                    <li class="mb-2">Once approved, package the item securely in its original box.</li>
                    <li class="mb-2">Ship the item to the provided return address using a trackable shipping service.</li>
                    <li>Once inspected at our warehouse, your refund will be processed to your original payment method within 5–7 business days.</li>
                </ol>
            </div>

            <div class="card border-0 shadow-sm p-4 bg-light">
                <h5 class="fw-bold mb-2">Non-Returnable Items</h5>
                <p class="mb-0 text-muted">Perishable goods, gift cards, clearance sale items, and opened personal care hygiene products are non-refundable.</p>
            </div>
        </div>
    </div>
</div>